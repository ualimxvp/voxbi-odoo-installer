<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="voxbi_backend_form" model="ir.ui.view">
        <field name="name">voxbi.backend.form</field>
        <field name="model">voxbi.backend</field>
        <field name="arch" type="xml">
            <form string="Voxbi Backend">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                    </group>
                    <group string="Connection">
                        <field name="cockpit_url" placeholder="https://cockpit.voxbi.com"/>
                        <field name="api_key" password="True"/>
                    </group>
                    <group string="Status">
                        <field name="cursor_since"/>
                        <field name="cursor_before"/>
                        <field name="backfill_done"/>
                        <field name="last_run"/>
                        <field name="last_error"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="voxbi_backend_list" model="ir.ui.view">
        <field name="name">voxbi.backend.list</field>
        <field name="model">voxbi.backend</field>
        <field name="arch" type="xml">
            <tree string="Voxbi Backends">
                <field name="name"/>
                <field name="cockpit_url"/>
                <field name="last_run"/>
                <field name="backfill_done"/>
            </tree>
        </field>
    </record>

    <record id="action_voxbi_backend" model="ir.actions.act_window">
        <field name="name">Voxbi Backends</field>
        <field name="res_model">voxbi.backend</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
