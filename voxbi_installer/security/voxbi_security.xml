<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_voxbi_user" model="res.groups">
        <field name="name">Voxbi: User</field>
    </record>
    <record id="group_voxbi_manager" model="res.groups">
        <field name="name">Voxbi: Manager</field>
        <field name="implied_ids" eval="[(4, ref('group_voxbi_user'))]"/>
        <!-- Odoo 19 renamed res.groups.users to user_ids. -->
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>
</odoo>
