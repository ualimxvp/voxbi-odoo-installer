<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="voxbi_call_rule_user" model="ir.rule">
        <field name="name">Voxbi: users see their own calls</field>
        <field name="model_id" ref="model_voxbi_call"/>
        <field name="groups" eval="[(4, ref('group_voxbi_user'))]"/>
        <field name="domain_force">['|', ('user_id', '=', user.id), ('participant_ids.user_id', '=', user.id)]</field>
    </record>
    <record id="voxbi_call_rule_manager" model="ir.rule">
        <field name="name">Voxbi: managers see all calls</field>
        <field name="model_id" ref="model_voxbi_call"/>
        <field name="groups" eval="[(4, ref('group_voxbi_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
